# clang-tidy configuration for KLayout.
#
# clang-tidy needs a compilation database (compile_commands.json). KLayout uses
# qmake, which does not emit one, so generate it with Bear first:
#
#   ./build.sh -dry-run            # or a normal build
#   bear -- make -C build-release  # wraps make to capture compile commands
#   run-clang-tidy -p build-release src/db/db/dbPolygon.cc
#
# The CI workflow runs these checks over the whole tree and fails on any
# finding, so the enabled set must stay clean tree-wide. The families below are
# enabled wholesale; individual checks are disabled (with a reason) only when
# the findings are intentional patterns, a deliberate codebase convention, or
# cannot be auto-fixed without risk. Re-enable a disabled check once its
# findings have been cleaned.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  readability-misleading-indentation,
  readability-redundant-control-flow,
  readability-redundant-smartptr-get,
  readability-container-size-empty,
  readability-redundant-string-init,
  readability-redundant-string-cstr,
  modernize-use-nullptr,
  modernize-use-bool-literals,
  misc-redundant-expression,
  misc-unused-using-decls,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -performance-no-int-to-ptr,
  -performance-enum-size,
  -performance-noexcept-move-constructor,
  -performance-noexcept-swap

# Disabled, with reasons (re-enable once cleaned):
#   - performance-enum-size: would shrink enum underlying types, an ABI/behaviour
#     change that is not worth making mechanically.
#   - performance-noexcept-move-constructor / -noexcept-swap: the fix inserts
#     "noexcept" once per template instantiation, so clang-tidy --fix stacks
#     duplicate tokens on templated headers and corrupts them. Apply by hand.

# Treat nothing as an error yet (informational rollout).
WarningsAsErrors: ''

# Only diagnose project headers, not system or third-party ones. clang-tidy
# matches these against the path as the compiler sees it (absolute, or relative
# like ../../../src/...), so anchor on the "/src/" segment rather than "^src/".
#
# NOTE: clang-tidy uses LLVM's regex engine, which has no lookahead support, so
# exclusions go in ExcludeHeaderFilterRegex (clang-tidy >= 19) rather than a
# "(?!...)" in HeaderFilterRegex. We exclude the generated Qt bindings (gsiqt)
# and the vendored Cap'n Proto tree under the lstream streamer, plus
# tl/tlAlgorithm.h, which is a verbatim copy of the gcc STL (stl_algo).
HeaderFilterRegex: '(/|^)src/'
ExcludeHeaderFilterRegex: '(/|^)src/(gsiqt/|tl/tl/tlAlgorithm\.h|plugins/streamers/lstream/(runtime|db_plugin/capnp)/)'

FormatStyle: file
