# clang-tidy configuration for KLayout.
#
# clang-tidy needs a compilation database (compile_commands.json). KLayout uses
# qmake, which does not emit one, so generate it with Bear first:
#
#   ./build.sh -dry-run            # or a normal build
#   bear -- make -C build-release  # wraps make to capture compile commands
#   run-clang-tidy -p build-release src/db/db/dbPolygon.cc
#
# Start narrow: run on the files you change, not the whole tree. The check set
# below favours correctness/bugprone findings and disables the noisiest
# stylistic and modernize checks so signal stays high. Expand over time.
#
# Backlog (enabled via bugprone-*/performance-* but not yet cleaned tree-wide;
# they fire only on files you touch, matching the incremental rollout):
#   - bugprone-empty-catch, bugprone-branch-clone: usually intentional;
#     review case by case rather than mass-rewriting.
#   - bugprone-integer-division, bugprone-incorrect-roundings,
#     bugprone-suspicious-semicolon: possible real bugs, need manual review.
#   - performance-noexcept-move-constructor/-swap and the modernize insertion
#     checks (use-override, use-equals-default): clang-tidy --fix stacks
#     duplicate edits on templated headers (one per instantiation), so apply
#     these by hand, not with run-clang-tidy -fix.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  readability-misleading-indentation,
  readability-redundant-control-flow,
  readability-redundant-smartptr-get,
  readability-container-size-empty,
  readability-redundant-string-init,
  readability-redundant-string-cstr,
  modernize-use-nullptr,
  modernize-use-bool-literals,
  misc-redundant-expression,
  misc-unused-using-decls,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -performance-no-int-to-ptr

# Treat nothing as an error yet (informational rollout).
WarningsAsErrors: ''

# Only diagnose project headers, not system or third-party ones. clang-tidy
# matches these against the path as the compiler sees it (absolute, or relative
# like ../../../src/...), so anchor on the "/src/" segment rather than "^src/".
#
# NOTE: clang-tidy uses LLVM's regex engine, which has no lookahead support, so
# exclusions go in ExcludeHeaderFilterRegex (clang-tidy >= 19) rather than a
# "(?!...)" in HeaderFilterRegex. We exclude the generated Qt bindings (gsiqt)
# and the vendored Cap'n Proto tree under the lstream streamer.
HeaderFilterRegex: '(/|^)src/'
ExcludeHeaderFilterRegex: '(/|^)src/(gsiqt/|plugins/streamers/lstream/(runtime|db_plugin/capnp)/)'

FormatStyle: file
